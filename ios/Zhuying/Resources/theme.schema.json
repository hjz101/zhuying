                  "maxLength": 512,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
