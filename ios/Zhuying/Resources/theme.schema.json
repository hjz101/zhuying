                "footerEnabled": {
                  "type": "boolean"
                },
                "headerHeight": {
                  "type": "number",
                  "minimum": 48,
                  "maximum": 140
                },
                "footerHeight": {
                  "type": "number",
                  "minimum": 48,
                  "maximum": 140
                },
                "headerGap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 48
                },
                "footerGap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 48
                },
