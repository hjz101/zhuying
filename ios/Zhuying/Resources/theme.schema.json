            "lineSpacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "preferences": {
              "type": "object",
              "properties": {
                "paragraphSpacing": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 48
