                  "enum": [
                    "平移",
                    "覆盖",
                    "仿真",
                    "无动画"
                  ]
                },
                "verticalEffect": {
                  "enum": [
                    "平移",
                    "覆盖",
                    "无动画"
                  ]
                },
                "rules": {
                  "type": "array",
