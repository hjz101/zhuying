                "leftMargin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                },
                "rightMargin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                },
                "topMargin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                },
                "bottomMargin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                },
