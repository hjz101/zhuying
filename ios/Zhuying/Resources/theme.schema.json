                  "maximum": 30
                },
                "godRadius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                },
                "bubbleColor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
