                        "type": "string",
                        "maxLength": 160
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "width": {
                        "type": "number",
                        "minimum": 15,
                        "maximum": 90
                      },
                      "fontSize": {
                        "type": "number",
                        "minimum": 9,
                        "maximum": 22
                      },
                      "color": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "zone",
                      "kind",
                      "text",
                      "x",
                      "y",
                      "width",
                      "fontSize"
