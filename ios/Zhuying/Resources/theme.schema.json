                  ]
                },
                "godBackground": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "godBorder": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "paragraphSpacing",
                "leftMargin",
                "rightMargin",
                "topMargin",
                "bottomMargin",
                "marginsLinked",
                "firstLineIndent",
                "fontWeight",
                "colors",
                "headerEnabled",
                "footerEnabled",
                "headerHeight",
                "footerHeight",
                "headerGap",
                "footerGap",
                "pageElements",
                "horizontalEffect",
                "verticalEffect",
                "rules",
                "showCommentBubbles",
                "showGodComments",
                "bubbleStyle",
                "godStyle",
                "bubbleRadius",
                "godRadius"
