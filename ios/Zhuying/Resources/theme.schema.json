                      "presentation": {
                        "enum": [
                          "文字高亮",
                          "段落底色",
                          "居中斜体",
                          "首字下沉"
                        ]
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "scope": {
                        "const": "全部书籍"
                      }
