{
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "app": {
      "type": "object",
      "properties": {
        "dark": {
          "type": "boolean"
        },
        "colors": {
          "type": "object",
          "properties": {
            "background.page": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "text.primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "text.secondary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background.card": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background.soft": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "action.primary.background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "action.primary.foreground": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "background.page",
            "text.primary",
            "text.secondary",
            "border",
            "accent",
            "background.card",
            "background.soft",
            "action.primary.background",
            "action.primary.foreground"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "icons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "selected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "disabled": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "pressed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "focused": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "loading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "template": {
                "type": "boolean"
              }
            },
            "required": [
              "template"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "symbol"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                }
              },
              {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "symbol"
                  ]
                }
              }
            ]
          }
        },
        "backgrounds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f]+$"
              },
              "mode": {
